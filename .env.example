# kabu-log local development environment.
# Copy to .env (gitignored) and adjust. Never commit real secrets.

DEBUG=1
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-change-me

# PostgreSQL runs in Docker (docker-compose.yml). Host port is 5433 to avoid the
# system cluster on 5432. dev/prod parity: same Postgres 16 + pgvector everywhere.
DATABASE_URL=postgres://kabulog:kabulog@localhost:5433/kabulog
POSTGRES_DB=kabulog
POSTGRES_USER=kabulog
POSTGRES_PASSWORD=kabulog

# Dev-only quick login (no Google secrets needed locally). DEBUG must be on.
DEV_LOGIN_EMAIL=n-honda@nippon-access.co.jp

# Comma-separated. Used by prod settings.
ALLOWED_HOSTS=localhost,127.0.0.1

# Semantic search. "local" runs an HF model on-box (private, needs the
# sentence-transformers extra + first-run model download). "fallback" uses a
# deterministic hash embedding with no deps/network (handy if you can't run the
# model). Tests always force "fallback".
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=intfloat/multilingual-e5-base
